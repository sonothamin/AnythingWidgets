{
  "schema": 1,
  "id": "ask",
  "version": 1,
  "name": "Ask",
  "description": "Think of a question. Tap for an answer.",
  "author": "AnythingWidgets",
  "created": "2026-10-12",
  "categories": [
    "Fun"
  ],
  "tags": [
    "random",
    "tap",
    "decide"
  ],
  "chrome": "none",
  "root": {
    "type": "column",
    "children": [
      {
        "type": "row",
        "children": [
          {
            "type": "text",
            "text": "ASK ANYTHING",
            "size": 12,
            "color": "n.ash",
            "grow": true,
            "bold": true
          },
          {
            "type": "box",
            "children": [],
            "width": 8,
            "height": 8,
            "radius": 4,
            "background": "n.red"
          }
        ],
        "align": "center",
        "fill": "width"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "glyph",
        "pool": [
          "YES",
          "NO",
          "MAYBE",
          "LATER",
          "SURE",
          "NOPE",
          "DO IT",
          "WAIT",
          "ASK AGAIN"

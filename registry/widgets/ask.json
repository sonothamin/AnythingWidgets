      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "text",
        "text": "TAP TO ASK AGAIN",
        "size": 10,
        "color": "n.ash",
        "bold": true
      }
    ],
    "fill": "both",
    "background": "n.dark",
    "radius": 32,
    "padding": 18,
    "gap": 6,
    "action": {
      "type": "refresh"

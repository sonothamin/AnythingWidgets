{
  "schema": 1,
  "id": "date",
  "version": 1,
  "name": "Date",
  "description": "A big serif number on paper white. Calm and quiet.",
  "author": "AnythingWidgets",
  "created": "2026-10-12",
  "categories": [
    "Time & Date"
  ],
  "tags": [
    "date",
    "serif",
    "minimal"
  ],
  "chrome": "none",
  "root": {
    "type": "row",
    "children": [
      {
        "type": "glyph",
        "text": "{{date.day}}",
        "size": 84,
        "color": "n.black",
        "font": "serif",
        "bold": true
      },
      {
        "type": "column",
        "children": [
          {
            "type": "text",
            "text": "{{date.weekday.upper}}",
            "size": 13,
            "color": "n.graphite",
            "bold": true
          },
          {
            "type": "text",
            "text": "{{date.month.long.upper}}",
            "size": 16,
            "color": "n.black",
            "bold": true
          },
          {
            "type": "text",
            "text": "{{date.year}}",
            "size": 12,
            "color": "n.graphite"
          }
        ],
        "grow": true,
        "justify": "center",
        "gap": 3
      }
    ],
    "fill": "both",
    "background": "n.white",
    "radius": 32,
    "padding": 18,
    "align": "center",
    "gap": 16,
    "action": {
      "type": "open_app"
    }
  },
  "compact": {
    "type": "column",
    "children": [
      {
        "type": "row",
        "children": [
          {
            "type": "box",
            "children": [],
            "width": 8,
            "height": 8,
            "radius": 4,
            "background": "n.red"
          },
          {
            "type": "spacer",
            "grow": true
          },
          {
            "type": "text",
            "text": "{{date.weekday.short.upper}}",
            "size": 11,
            "color": "n.graphite",
            "bold": true
          }
        ],
        "align": "center",
        "fill": "width"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "glyph",
        "text": "{{date.day}}",
        "size": 58,
        "color": "n.black",
        "font": "serif",
        "bold": true
      }
    ],
    "fill": "both",
    "background": "n.white",
    "radius": 32,
    "padding": 14,
    "action": {
      "type": "open_app"
    }
  },
  "large": {
    "type": "column",
    "children": [
      {
        "type": "row",
        "children": [
          {
            "type": "box",
            "children": [],
            "width": 8,
            "height": 8,
            "radius": 4,
            "background": "n.red"
          },
          {
            "type": "spacer",
            "grow": true
          },
          {
            "type": "text",
            "text": "{{date.year}}",
            "size": 13,
            "color": "n.graphite",
            "bold": true
          }
        ],
        "align": "center",
        "fill": "width"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "glyph",
        "text": "{{date.day}}",
        "size": 150,
        "color": "n.black",
        "font": "serif",
        "bold": true
      },
      {
        "type": "text",
        "text": "{{date.weekday.upper}}",
        "size": 14,
        "color": "n.graphite",
        "bold": true
      },
      {
        "type": "text",
        "text": "{{date.month.long.upper}}",
        "size": 18,
        "color": "n.black",
        "bold": true
      }
    ],
    "fill": "both",
    "background": "n.white",
    "radius": 40,
    "padding": 22,
    "gap": 2,
    "action": {
      "type": "open_app"
    }
  }
}

{
  "schema": 2,
  "id": "fact",
  "version": 2,
  "name": "Daily Fact",
  "description": "A fresh trivia fact every day from Open Trivia DB. Pick a topic and difficulty; 30 are kept on the device.",
  "author": "AnythingWidgets",
  "created": "2026-10-12",
  "categories": [
    "Fun"
  ],
  "tags": [
    "fact",
    "daily",
    "trivia"
  ],
  "chrome": "none",
  "params": [
    {
      "id": "genre",
      "type": "choice",
      "label": "Topic",
      "description": "What the facts are about.",
      "default": "any",
      "choices": [
        {
          "value": "any",
          "label": "Anything"
        },
        {
          "value": "9",
          "label": "General knowledge"
        },
        {
          "value": "17",
          "label": "Science & nature"
        },
        {
          "value": "22",
          "label": "Geography"
        },
        {
          "value": "23",
          "label": "History"
        },
        {
          "value": "27",
          "label": "Animals"
        },
        {
          "value": "21",
          "label": "Sports"
        },
        {
          "value": "11",
          "label": "Film"
        },
        {
          "value": "12",
          "label": "Music"
        },
        {
          "value": "14",
          "label": "Television"
        },
        {
          "value": "15",
          "label": "Video games"
        },
        {
          "value": "18",
          "label": "Computers"
        },
        {
          "value": "19",
          "label": "Mathematics"
        },
        {
          "value": "20",
          "label": "Mythology"
        },
        {
          "value": "25",
          "label": "Art"
        },
        {
          "value": "10",
          "label": "Books"
        }
      ]
    },
    {
      "id": "difficulty",
      "type": "choice",
      "label": "Difficulty",
      "description": "How obscure the facts get.",
      "default": "any",
      "choices": [
        {
          "value": "any",
          "label": "Any"
        },
        {
          "value": "easy",
          "label": "Easy"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "hard",
          "label": "Hard"
        }
      ]
    },
    {
      "id": "showAnswer",
      "type": "toggle",
      "label": "Show the answer",
      "default": true
    }
  ],
  "feeds": [
    {
      "id": "fact",
      "ttl": 43200,
      "list": "results",
      "keep": 30,
      "url": "https://opentdb.com/api.php?amount=30&type=multiple&category={{param.genre}}&difficulty={{param.difficulty}}",
      "fields": {
        "question": "question",
        "answer": "correct_answer",
        "category": "category"
      }
    }
  ],
  "root": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "{{feed.fact.question}}",
        "size": 13,
        "color": "n.black",
        "maxLines": 3,
        "bold": true,
        "visible": "feed.fact.ok"
      },
      {
        "type": "text",
        "text": "→ {{feed.fact.answer}}",
        "size": 15,
        "color": "n.red",
        "maxLines": 2,
        "bold": true,
        "visible": "feed.fact.ok && param.showAnswer"
      },
      {
        "type": "text",
        "pool": [
          "Honey found in ancient tombs was still edible.",
          "Octopuses have three hearts.",
          "Bananas are berries. Strawberries are not.",
          "A day on Venus is longer than its year.",
          "Wombat droppings are cube-shaped.",
          "Antarctica is the largest desert on Earth.",
          "Crows can remember human faces.",
          "Sharks are older than trees.",
          "The Moon drifts about 3.8 cm farther every year.",
          "Sunlight takes about 8 minutes to reach Earth.",
          "A group of flamingos is called a flamboyance.",
          "Cleopatra lived nearer to us than to the first pyramids.",
          "Butterflies taste with their feet.",
          "A teaspoon of neutron star weighs billions of tons.",
          "Sea otters hold hands while they sleep.",
          "Venus spins backwards compared to most planets.",
          "Scotland’s national animal is the unicorn."
        ],
        "size": 15,
        "color": "n.black",
        "maxLines": 3,
        "bold": true,
        "visible": "!feed.fact.ok"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "box",
        "children": [],
        "width": 36,
        "height": 2,
        "background": "n.red"
      },
      {
        "type": "text",
        "text": "{{feed.fact.category}} · {{feed.fact.index}}/{{feed.fact.count}}",
        "size": 10,
        "color": "n.black",
        "maxLines": 1,
        "visible": "feed.fact.ok"
      },
      {
        "type": "glyph",
        "text": "TODAY'S FACT",
        "size": 14,
        "color": "n.black",
        "visible": "!feed.fact.ok && net.allowed"
      },
      {
        "type": "text",
        "text": "Allow internet access in the app for daily facts",
        "size": 9,
        "color": "n.black",
        "maxLines": 2,
        "visible": "!net.allowed"
      }
    ],
    "fill": "both",
    "background": "n.white",
    "radius": 32,
    "padding": 18,
    "gap": 6,
    "action": {
      "type": "open_app"
    }
  },
  "compact": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "{{feed.fact.question}}",
        "size": 10,
        "color": "n.black",
        "maxLines": 4,
        "bold": true,
        "visible": "feed.fact.ok"
      },
      {
        "type": "text",
        "text": "→ {{feed.fact.answer}}",
        "size": 12,
        "color": "n.red",
        "maxLines": 2,
        "bold": true,
        "visible": "feed.fact.ok && param.showAnswer"
      },
      {
        "type": "text",
        "pool": [
          "Honey found in ancient tombs was still edible.",
          "Octopuses have three hearts.",
          "Bananas are berries. Strawberries are not.",
          "A day on Venus is longer than its year.",
          "Wombat droppings are cube-shaped.",
          "Antarctica is the largest desert on Earth.",
          "Crows can remember human faces.",
          "Sharks are older than trees.",
          "The Moon drifts about 3.8 cm farther every year.",
          "Sunlight takes about 8 minutes to reach Earth.",
          "A group of flamingos is called a flamboyance.",
          "Cleopatra lived nearer to us than to the first pyramids.",
          "Butterflies taste with their feet.",
          "A teaspoon of neutron star weighs billions of tons.",
          "Sea otters hold hands while they sleep.",
          "Venus spins backwards compared to most planets.",
          "Scotland’s national animal is the unicorn."
        ],
        "size": 11,
        "color": "n.black",
        "maxLines": 4,
        "bold": true,
        "visible": "!feed.fact.ok"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "box",
        "children": [],
        "width": 28,
        "height": 2,
        "background": "n.red"
      },
      {
        "type": "glyph",
        "text": "FACT",
        "size": 13,
        "color": "n.black",
        "visible": "!feed.fact.ok && net.allowed"
      },
      {
        "type": "text",
        "text": "Allow internet access in the app for daily facts",
        "size": 9,
        "color": "n.black",
        "maxLines": 2,
        "visible": "!net.allowed"
      }
    ],
    "fill": "both",
    "background": "n.white",
    "radius": 32,
    "padding": 14,
    "gap": 4,
    "action": {
      "type": "open_app"
    }
  },
  "large": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "{{feed.fact.question}}",
        "size": 18,
        "color": "n.black",
        "maxLines": 6,
        "bold": true,
        "visible": "feed.fact.ok"
      },
      {
        "type": "text",
        "text": "→ {{feed.fact.answer}}",
        "size": 22,
        "color": "n.red",
        "maxLines": 3,
        "bold": true,
        "visible": "feed.fact.ok && param.showAnswer"
      },
      {
        "type": "text",
        "pool": [
          "Honey found in ancient tombs was still edible.",
          "Octopuses have three hearts.",

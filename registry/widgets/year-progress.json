{
  "schema": 1,
  "id": "year-progress",
  "version": 1,
  "name": "Year in Dots",
  "description": "Every day of the year as a dot. Today glows red.",
  "author": "AnythingWidgets",
  "created": "2026-10-12",
  "categories": [
    "Time & Date"
  ],
  "tags": [
    "year",
    "progress",
    "dots"
  ],
  "chrome": "none",
  "root": {
    "type": "row",
    "children": [
      {
        "type": "column",
        "children": [
          {
            "type": "text",
            "text": "{{date.year}}",
            "size": 13,
            "color": "n.ash",
            "bold": true
          },
          {
            "type": "glyph",
            "text": "{{date.year.percent}}%",
            "size": 44,
            "color": "n.white"
          },
          {
            "type": "text",
            "text": "{{date.year.daysLeft}} DAYS LEFT",
            "size": 11,
            "color": "n.ash",
            "bold": true
          }
        ],
        "grow": true,
        "justify": "center",
        "gap": 4
      },
      {
        "type": "dotgrid",
        "columns": 31,
        "rows": 12,
        "width": 126,
        "height": 78,
        "color": "n.white",
        "track": "n.dot",
        "accent": "n.red",
        "pattern": "{{year.pattern}}"
      }
    ],
    "fill": "both",
    "background": "n.dark",
    "radius": 32,
    "padding": 16,
    "align": "center",
    "gap": 12,
    "action": {
      "type": "open_app"
    }
  },
  "compact": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "{{date.year}}",
        "size": 12,
        "color": "n.ash",
        "bold": true
      },
      {
        "type": "glyph",
        "text": "{{date.year.percent}}%",
        "size": 32,
        "color": "n.white"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "dotgrid",
        "columns": 31,
        "rows": 12,
        "width": 82,
        "height": 56,
        "color": "n.white",
        "track": "n.dot",
        "accent": "n.red",
        "pattern": "{{year.pattern}}"
      }
    ],
    "fill": "both",
    "background": "n.dark",
    "radius": 32,
    "padding": 14,
    "gap": 4,
    "action": {
      "type": "open_app"
    }
  },
  "large": {
    "type": "column",
    "children": [
      {
        "type": "row",
        "children": [
          {
            "type": "text",
            "text": "{{date.year}}",
            "size": 14,
            "color": "n.ash",
            "grow": true,
            "bold": true
          },
          {
            "type": "text",
            "text": "{{date.year.daysLeft}} DAYS LEFT",
            "size": 13,
            "color": "n.ash",
            "textAlign": "end",
            "bold": true
          }
        ],
        "fill": "width"
      },
      {
        "type": "glyph",
        "text": "{{date.year.percent}}%",
        "size": 72,
        "color": "n.white"
      },
      {
        "type": "spacer",
        "grow": true
      },
      {
        "type": "dotgrid",
        "columns": 31,
        "rows": 12,
        "width": 210,
        "height": 108,
        "color": "n.white",
        "track": "n.dot",
        "accent": "n.red",
        "pattern": "{{year.pattern}}"
      }
    ],
    "fill": "both",
    "background": "n.dark",
    "radius": 40,
    "padding": 20,
    "gap": 8,
    "action": {
      "type": "open_app"
    }
  }
}
